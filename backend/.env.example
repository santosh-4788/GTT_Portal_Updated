# ---------------------------------------------------------------------------
# Gupta Tours & Travels — backend configuration
# Copy this file to  backend\.env  and edit the values you need.
# Every setting has a working default, so the app runs even without a .env file.
# ---------------------------------------------------------------------------

# Server
# 4000, 4200 and 5173 are used by other applications on this machine,
# so the portal runs on 4100. Change it here if that ever clashes too.
PORT=4100
NODE_ENV=development

# Security — CHANGE THIS BEFORE PUTTING THE PORTAL ON A SHARED NETWORK.
# Any long random string works. Changing it signs everyone out.
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
SESSION_TIMEOUT_MINUTES=60

# Which origins may call the API (comma separated). 5273 is the dev server.
# Add the LAN address of this machine when other computers need access, e.g.
# CORS_ORIGINS=http://localhost:5273,http://192.168.1.20:4100
CORS_ORIGINS=http://localhost:5273,http://127.0.0.1:5273

# Database — SQLite file. Keep it on the E: drive.
DB_FILE=E:\Portal\ProjectTool\database\gtt.db

# Read-only reference folder holding the original vendor invoice formats.
# The application only ever COPIES from here; it never writes to it.
INVOICE_FORMAT_SOURCE=E:\Portal\InvoiceFormat

# Uploads — 15 MB
MAX_UPLOAD_BYTES=15728640

# Initial administrator created by "npm run seed".
# The account is forced to change this password at first sign-in.
SEED_ADMIN_EMAIL=Admin@gmail.com
SEED_ADMIN_PASSWORD=Pass@123
SEED_ADMIN_NAME=Vinay Gupta

# Optional: full path to LibreOffice for XLSX/DOCX -> PDF conversion.
# Leave unset if LibreOffice is not installed — invoices still generate normally.
# LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# ---------------------------------------------------------------------------
# Email  (free — Gmail's own SMTP, no transactional email service)
# ---------------------------------------------------------------------------
# Everything the portal sends goes out from ONE mailbox: enquiry
# acknowledgements to the customer, the enquiry alert to the office, trip
# details when a car and driver are allotted, and invoices.
#
# Setting it up, once:
#   1. Turn on 2-Step Verification for the Google account below.
#   2. Google Account -> Security -> App passwords -> create one for "Mail".
#   3. Paste the 16 characters (no spaces) into MAIL_APP_PASSWORD.
#
# Until that is done the portal runs normally, every message is held in the
# email log with the reason, and the office can resend from Settings -> Email.
MAIL_APP_PASSWORD=
MAIL_FROM=vinaykumar87674@gmail.com
MAIL_FROM_NAME=Gupta Tours & Travels
MAIL_USER=vinaykumar87674@gmail.com
MAIL_REPLY_TO=vinaykumar87674@gmail.com
# Where customer enquiries are delivered. The same mailbox by default.
MAIL_ADMIN_INBOX=vinaykumar87674@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=465
MAIL_SECURE=true

# The public address of the website, used to build "Track this trip" links
# inside emails. Leave blank while the portal only runs on this machine.
# PUBLIC_URL=https://gupta-tours.example.com

# ---------------------------------------------------------------------------
# Customer sign-in with Google  (optional, free)
# ---------------------------------------------------------------------------
# Create an OAuth 2.0 Client ID (type: Web application) at
# https://console.cloud.google.com/apis/credentials and add the site's address
# to "Authorised JavaScript origins". Leave blank and the Google button is
# hidden — customers can still sign in with an email address and password.
# GOOGLE_CLIENT_ID=1234567890-abcdefg.apps.googleusercontent.com
