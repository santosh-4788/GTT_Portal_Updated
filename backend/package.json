{
  "name": "gtt-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Gupta Tours & Travels - Booking, Vendor Billing & Invoice Management API",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "setup": "npm run migrate && npm run seed",
    "backup": "tsx scripts/backup.ts",
    "backup:list": "tsx scripts/backup.ts list",
    "reset-admin": "tsx scripts/reset-admin.ts",
    "verify-template": "tsx scripts/test-invoice.ts",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^11.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "docxtemplater": "^3.50.0",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "nodemailer": "^6.10.1",
    "pdfkit": "^0.15.1",
    "pizzip": "^3.1.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.12",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "@types/pdfkit": "^0.13.9",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
