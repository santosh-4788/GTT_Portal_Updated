{
  "name": "gtt-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:mobile": "vite --config vite.mobile.config.ts",
    "build:mobile": "tsc -b && vite build --config vite.mobile.config.ts",
    "cap:sync": "npm run build:mobile && cap sync android",
